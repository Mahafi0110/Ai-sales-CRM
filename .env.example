APP_NAME=AI Sales & CRM Agent
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg2://crm:crm@db:5432/crm
REDIS_URL=redis://redis:6379/0
SECRET_KEY=replace-with-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
COOKIE_SECURE=false
CURRENCY_SYMBOL=$
# AI (free Gemini key from https://aistudio.google.com : sign in, click "Get API key")
LLM_PROVIDER=gemini
LLM_MODEL=gemini-flash-latest
GOOGLE_API_KEY=
# AI assistant limits (they protect the free quota); defaults are fine to start
# AGENT_MAX_STEPS=6
# AGENT_RUNS_PER_HOUR=20

# --- Running the app from VS Code (not inside Docker)? Use these two lines instead of the DATABASE_URL and REDIS_URL above:
# DATABASE_URL=postgresql+psycopg2://crm:crm@localhost:5432/crm
# REDIS_URL=redis://localhost:6379/0

# Sending email. "console" = only write the email to the server log (nothing is delivered). For real sending use smtp,
# e.g. Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=you@gmail.com, SMTP_PASSWORD=<an app password>
EMAIL_BACKEND=console
EMAIL_FROM=you@example.com
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_USE_TLS=true

# Company knowledge (documents the AI can use). Keyword search always works. Semantic search (finds passages by
# meaning) uses the same GOOGLE_API_KEY and Gemini's free embedding model.
# KNOWLEDGE_SEMANTIC=true
# EMBEDDING_MODEL=gemini-embedding-001
